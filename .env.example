EMBEDDING_BATCH_SIZE=64
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=500
OCR_MIN_CHARS=80
DATA_DIR=data/documents
ENABLE_OCR=false
ENABLE_MULTI_QUERY=true
ENABLE_COMPRESSION=true
ENABLE_CITATION_AUDIT=true
